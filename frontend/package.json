{
"name": "frontend",
  "version": "1.0.0",
  "description": "This directory will contain the React web application for EchoMirror — a companion web dashboard to the Flutter mobile app.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@sentry/react": "^11.14.0",
    "@stellar/freighter-api": "^6.0.1",
    "@supabase/supabase-js": "^2.119.1",
    "@tanstack/react-query": "^5.108.0",
    "html-to-image": "^1.11.13",
    "i18next": "^27.2.1",
    "i18next-browser-languagedetector": "^8.3.1",
    "jspdf": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
