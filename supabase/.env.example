# Supabase Edge Function secrets (set via: supabase secrets set KEY=value)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stellar wallet provisioning
STELLAR_NETWORK=testnet
STELLAR_ISSUER_PUBLIC_KEY=G...
STELLAR_ASSET_CODE=ECHO
WALLET_ENCRYPTION_KEY=base64_encoded_32_byte_aes_key

# Existing optional secrets used by other edge functions
GEMINI_API_KEY=your_gemini_api_key_here
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERT=your_agora_app_certificate_here
