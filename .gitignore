# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Sensitive files - API keys, secrets, constants
**/local.properties
**/.env
**/.env.*
!**/.env.example
**/*secret*
# ...but code may legitimately name a secret: issue #763 adds
# supabase/functions/_shared/require-cron-secret.ts, and a source file that was
# silently ignored (and therefore never compiled by the job that runs it) is
# worse than the rule is useful. Credential *files* stay ignored.
!supabase/functions/**/*.ts
**/config/passwords.yaml

# Documentation files (except README.md)
ARCHITECTURE.md
GEMINI_INTEGRATION.md
SERVERPOD_SETUP.md

# Build and generated files
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
# *.lock (pubspec.lock must be committed!)
node_modules/

# Redis dump and scratch/scratch files
dump.rdb
*.rdb
pr_msg_*.txt
*_config.txt
